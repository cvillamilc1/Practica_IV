{
  "name": "plataforma-software-libre",
  "version": "1.0.0",
  "description": "Plataforma educativa de Software Libre con base de datos PostgreSQL persistente",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "db:schema": "node scripts/aplicar-esquema.js",
    "seed:admins": "node scripts/crear-admins.js",
    "import:local": "node scripts/importar-localstorage.js",
    "test": "node --test tests/pruebas.js tests/frontend.js",
    "test:api": "node --test tests/pruebas.js",
    "test:frontend": "node --test tests/frontend.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}